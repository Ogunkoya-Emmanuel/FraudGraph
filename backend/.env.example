# Copy this file to ".env" and fill in your own values.
# .env is read automatically on startup - never commit your real .env to git.

# --- Database (PostgreSQL) ---
# Start a local one with:  docker compose up -d
# Hosted providers' "postgres://..." / "postgresql://..." URLs also work (auto-converted).
# For a quick throwaway test you can still use SQLite instead:  sqlite:///./fraudgraph.db
DATABASE_URL=postgresql+psycopg2://fraudgraph:fraudgraph@localhost:5432/fraudgraph

# --- API security ---
# If set, every /api/v1 request must send this value in an "X-API-Key" header.
# Leave blank only for local development.
API_KEY=
# Comma-separated browser origins allowed to call the API (your frontend). No wildcard.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Gemini (optional) ---
# If set, FraudGraph asks Gemini to reword each alert's rule-based explanation. Account and
# device IDs are replaced with placeholders before anything is sent. If this is blank, or the
# Gemini call fails for any reason, the app falls back to the rule-based explanation - it
# NEVER depends on Gemini to function.
# NOTE: gemini-2.0-flash was shut down by Google on 1 June 2026. Model IDs retire quickly -
# check https://ai.google.dev/gemini-api/docs/deprecations before the demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
