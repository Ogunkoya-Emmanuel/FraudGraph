# Copy to ".env" (or ".env.local") to override. Vite only exposes variables that start with VITE_.

# Where the FraudGraph API lives (no trailing slash needed).
# The backend must list THIS site's origin in its CORS_ORIGINS (default allows
# http://localhost:3000 and http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8000
